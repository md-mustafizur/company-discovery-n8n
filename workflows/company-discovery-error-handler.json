      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "// Sanitize Error - Run Once for All Items\n\n// Admin chat that receives critical failure alerts (change here if the admin changes)\nconst ADMIN_CHAT_ID = 0; // replace 0 with your own Telegram chat ID\n\n// Remove anything that looks like a secret and shorten the text\nfunction sanitize(text) {\n  return String(text || 'No error message')\n    .replace(/Bearer\\s+[A-Za-z0-9\\-._~+\\/]+=*/gi, 'Bearer [REDACTED]')\n    .replace(/(api[_-]?key|token|authorization|secret)[\"'\\s:=]+[A-Za-z0-9\\-._~+\\/]{8,}/gi, '$1=[REDACTED]')\n    .replace(/\\b(sk|apify_api|xox[a-z])[-_A-Za-z0-9]{10,}/gi, '[REDACTED]')\n    .replace(/\\s+/g, ' ')\n    .slice(0, 300);\n}\n\n// Telegram reads _ * ` [ ] as formatting, which can break or distort the alert\nfunction plainForTelegram(text) {\n  return String(text).replace(/[_*`\\[\\]]/g, ' ');\n}\n\nconst data = $input.first().json;\nconst execution = data.execution || {};\nconst workflow = data.workflow || {};\nconst error = execution.error || {};\n\nconst safeMessage = sanitize(error.message);\nconst failedNode = execution.lastNodeExecuted || 'unknown';\n\nconst alertText = plainForTelegram([\n  'CRITICAL: workflow failed',\n  'Workflow: ' + (workflow.name || 'unknown'),\n  'Failed at node: ' + failedNode,\n  'Error: ' + safeMessage,\n  'Execution ID: ' + (execution.id || 'n/a'),\n  'Details: ' + (execution.url || 'n/a')\n].join('\\n'));\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    workflow_name: workflow.name || 'unknown',\n    execution_id: String(execution.id || ''),\n    stage: failedNode,\n    company_url: null,\n    error_code: 'WORKFLOW_ERROR',\n    sanitized_error_message: safeMessage,\n    retry_count: 0,\n    resolved_status: 'open',\n    chat_id: ADMIN_CHAT_ID,\n    alert_text: alertText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
